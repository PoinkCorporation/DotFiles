PROTO_DIR := /home/maksim/Projects/Go/Project/chat/proto
OUT_DIR := /home/maksim/Projects/Go/Project/chat/gen/go
PROTOC := protoc
PROTO_FILES := $(wildcard $(PROTO_DIR)/*.proto)
proto-gen: $(PROTO_FILES)
	@mkdir -p $(OUT_DIR)
	$(PROTOC) \
		--proto_path=/home/maksim/Projects/Go/Project/chat/proto \
		--go_out=/home/maksim/Projects/Go/Project/chat/gen/go \
		--go_opt=paths=source_relative \
		--go-grpc_out=/home/maksim/Projects/Go/Project/chat/gen/go \
		--go-grpc_opt=paths=source_relative \
		/home/maksim/Projects/Go/Project/chat/proto/chat.proto
proto-clean:
	rm -f $(OUT_DIR)/*.pb.go $(OUT_DIR)/*_grpc.pb.go
proto-tools:
	go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
	go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest